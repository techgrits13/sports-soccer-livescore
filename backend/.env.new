# ========================================
# Cache Configuration (in seconds)
# ========================================
# Aggressive caching to minimize API requests
CACHE_TTL_LIVE=30          # 30 seconds for live matches
CACHE_TTL_FIXTURES=1800    # 30 minutes for fixtures
CACHE_TTL_STANDINGS=3600   # 1 hour for standings  
CACHE_TTL_TEAMS=86400      # 24 hours for team data
CACHE_TTL_LEAGUES=86400    # 24 hours for league data
CACHE_TTL_STATISTICS=300   # 5 minutes for statistics

# Short/Medium/Long presets (legacy)
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=1800
CACHE_TTL_LONG=3600
CACHE_TTL_VERY_LONG=86400

# ========================================
# Redis Configuration (Optional - for Production)
# ========================================
# For production, consider using Redis for distributed caching
# This helps when you have multiple server instances
REDIS_URL=redis://localhost:6379
USE_REDIS=false

# If using Redis on Render.com, uncomment and add your Redis URL:
# REDIS_URL=redis://red-xxxxx:6379
# USE_REDIS=true

# ========================================
# CORS Configuration
# ========================================
# Allow requests from your frontend
CORS_ORIGIN=*

# For production, specify your frontend URL:
# CORS_ORIGIN=https://your-frontend-domain.com

# ========================================
# Rate Limiting
# ========================================
# Protect your API from abuse
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window

# ========================================
# Logging
# ========================================
LOG_LEVEL=info  # Options: error, warn, info, debug

# ========================================
# NOTES:
# ========================================
# 1. Livescore API is PRIMARY - will be used first
# 2. API-Football is FAILOVER - used when Livescore quota exceeded
# 3. Caching reduces API usage significantly
# 4. Monitor quota status via /api/status endpoint
# 5. For Render deployment, add these as Environment Variables
# ========================================
